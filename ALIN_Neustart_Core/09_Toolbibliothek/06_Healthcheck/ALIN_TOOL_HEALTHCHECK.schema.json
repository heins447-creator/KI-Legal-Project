{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ALIN Tool-Healthcheck",
  "description": "Schema für den Tool-Healthcheck.",
  "type": "object",
  "required": ["schema_version", "healthcheck_id", "zeitstempel", "pruefungen"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0.0"] },
    "healthcheck_id": { "type": "string", "const": "tool_healthcheck" },
    "zeitstempel": { "type": "string", "format": "date-time" },
    "pruefungen": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool_id", "status", "details"],
        "properties": {
          "tool_id": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["vorhanden", "testbar", "letzter_test_ok", "letzter_test_alt", "fehlt", "unklar", "blockiert", "nur_dry_run", "manuelle_pruefung_erforderlich"]
          },
          "details": { "type": "string" }
        }
      }
    }
  }
}
