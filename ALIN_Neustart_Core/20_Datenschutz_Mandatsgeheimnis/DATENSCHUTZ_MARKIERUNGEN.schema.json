{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ALIN Datenschutz-Markierungen",
  "description": "Schema für Datenschutz-Markierungen.",
  "type": "object",
  "required": ["schema_version", "markierung_id", "objekt_id", "markierungen"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0.0"] },
    "markierung_id": { "type": "string" },
    "objekt_id": { "type": "string" },
    "markierungen": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "mandatsbezogen",
          "personenbezogen",
          "besonders_schutzbeduerftig",
          "nur_lokal",
          "nicht_exportieren",
          "nicht_an_externe_modelle",
          "cloud_verboten"
        ]
      }
    }
  }
}
