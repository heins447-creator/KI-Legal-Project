{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ALIN Modulregister",
  "description": "Zentrales Verzeichnis aller ALIN-Module. Jedes Modul meldet sich hier an.",
  "type": "object",
  "required": ["schema_version", "register_id", "letzte_aenderung", "eintraege"],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Version dieses Schemas",
      "enum": ["1.0.0"]
    },
    "register_id": {
      "type": "string",
      "const": "modulregister"
    },
    "letzte_aenderung": {
      "type": "string",
      "format": "date-time"
    },
    "eintraege": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "modul_id",
          "modulname",
          "pfad",
          "version",
          "zweck",
          "eingabe_schema",
          "ausgabe_schema",
          "status",
          "letzter_test",
          "abhaengig_von",
          "liefert",
          "darf_aufgerufen_werden",
          "warnungen"
        ],
        "properties": {
          "modul_id": {
            "type": "string",
            "description": "Eindeutige Modul-ID, z. B. POST-014, KM12, UI01",
            "pattern": "^[A-Z0-9_-]+$"
          },
          "modulname": {
            "type": "string",
            "description": "Menschlich lesbarer Name"
          },
          "pfad": {
            "type": "string",
            "description": "Relativer Pfad zum Modul im Projekt"
          },
          "version": {
            "type": "string",
            "description": "Semantische Version des Moduls"
          },
          "zweck": {
            "type": "string",
            "description": "Kurzbeschreibung der Aufgabe"
          },
          "eingabe_schema": {
            "type": "string",
            "description": "Name des Eingabe-Schemas in 03_Schnittstellen"
          },
          "ausgabe_schema": {
            "type": "string",
            "description": "Name des Ausgabe-Schemas in 03_Schnittstellen"
          },
          "status": {
            "type": "string",
            "enum": ["produktiv", "testbar", "entwicklung", "revision", "gesperrt", "ersetzt"],
            "description": "Betriebsstatus des Moduls"
          },
          "letzter_test": {
            "type": "string",
            "format": "date-time",
            "description": "Zeitstempel des letzten erfolgreichen Tests"
          },
          "abhaengig_von": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Liste der modul_ids, von denen dieses Modul abhängt"
          },
          "liefert": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Liste der modul_ids, die von diesem Modul abhängen"
          },
          "darf_aufgerufen_werden": {
            "type": "boolean",
            "description": "Ob das Modul aktuell aufgerufen werden darf"
          },
          "warnungen": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Aktive Warnungen zu diesem Modul"
          }
        }
      }
    }
  }
}
