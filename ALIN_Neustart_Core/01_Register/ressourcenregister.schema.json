{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ALIN Ressourcenregister",
  "description": "Zentrales Verzeichnis aller Ressourcen (Sprachpakete, OCR-Modelle, Übersetzungsressourcen, Terminologien, Quellen, UI-Hilfen, Sicherheitsressourcen).",
  "type": "object",
  "required": ["schema_version", "register_id", "letzte_aenderung", "eintraege"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0.0"] },
    "register_id": { "type": "string", "const": "ressourcenregister" },
    "letzte_aenderung": { "type": "string", "format": "date-time" },
    "eintraege": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "resource_id",
          "typ",
          "sprache",
          "land",
          "rechtsraum",
          "rechtsgebiet",
          "dokumenttyp",
          "pfad",
          "status",
          "offline_verfuegbar",
          "online_erforderlich",
          "fallback",
          "letzte_pruefung",
          "warnungen"
        ],
        "properties": {
          "resource_id": { "type": "string", "pattern": "^[A-Z0-9_-]+$" },
          "name": { "type": "string", "description": "Menschenlesbarer Name der Ressource" },
          "typ": {
            "type": "string",
            "enum": [
              "ocr_sprachpaket",
              "uebersetzungsmodell",
              "terminologie",
              "schriftart",
              "vorlage",
              "quellenregister",
              "adapter",
              "windows_app_ressource",
              "ui_hilfe",
              "sicherheitsressource",
              "sonstiges"
            ]
          },
          "sprache": { "type": "string", "description": "ISO 639-1 Code, z. B. de, sv, en" },
          "land": { "type": "string", "description": "ISO 3166-1 Alpha-2, z. B. DE, SE, US" },
          "rechtsraum": { "type": "string", "description": "z. B. EU, Bundesrepublik Deutschland, Schweden" },
          "rechtsgebiet": { "type": "string", "description": "z. B. Arbeitsrecht, Zivilrecht" },
          "dokumenttyp": { "type": "string", "description": "z. B. Arbeitsvertrag, Klageschrift" },
          "pfad": { "type": "string", "description": "Relativer Pfad zur Ressource" },
          "vorhanden_ja_nein_unbekannt": {
            "type": "string",
            "enum": ["ja", "nein", "unbekannt"],
            "description": "Physische Verfügbarkeit der Ressource"
          },
          "status": {
            "type": "string",
            "enum": ["freigegeben", "testbar", "veraltet", "gesperrt", "fehlt"]
          },
          "pruefstatus": {
            "type": "string",
            "enum": ["geprueft", "ungeprueft", "fehlerhaft", "nicht_pruefbar"],
            "description": "Qualitätsprüfstatus der Ressource"
          },
          "tool_id": { "type": "string", "description": "Verweis auf zugehöriges Tool im Toolregister" },
          "update_id": { "type": "string", "description": "Verweis auf Eintrag im Update-Register" },
          "lizenz_id": { "type": "string", "description": "Verweis auf Eintrag im Lizenzregister" },
          "version": { "type": "string", "description": "Versionsangabe der Ressource" },
          "hash": { "type": "string", "description": "SHA256 oder ähnlicher Hash der Ressource" },
          "offline_verfuegbar": { "type": "boolean" },
          "online_erforderlich": { "type": "boolean" },
          "darf_von_modulen_verwendet_werden": { "type": "boolean", "description": "Gate: Fachmodule dürfen diese Ressource verwenden" },
          "fallback": { "type": "string", "description": "resource_id des Fallbacks" },
          "letzte_pruefung": { "type": "string", "format": "date-time" },
          "warnungen": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
